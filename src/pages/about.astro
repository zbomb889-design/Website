---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Brandmark from "@/components/brandmark.astro";
import { Icon } from "astro-icon/components";

const credentials = [
  { label: "GAF Certified Installer", icon: "bx:bxs-badge-check" },
  { label: "CertainTeed Certified", icon: "bx:bxs-award" },
  { label: "Firestone / Versico Certified", icon: "bx:bxs-shield-alt-2" },
  { label: "Johns Manville Certified", icon: "bx:bxs-check-shield" },
  { label: "National Roofing Contractors Association", icon: "bx:bxs-buildings" },
  { label: "Associated Builders and Contractors", icon: "bx:bxs-medal" },
];
---

<Layout title="About">
  <Container>
    <Sectionhead>
      <Fragment slot="title">About Maly Roofing</Fragment>
      <Fragment slot="desc">Greater Madison's commercial roofing crew.</Fragment>
    </Sectionhead>

    <div class="flex justify-center mt-10">
      <Brandmark class="w-20 h-16" />
    </div>

    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-10">
      <h2 class="font-bold text-3xl text-gray-800">
        Serving Madison-area roofs since 1988.
      </h2>
      <p class="text-lg leading-relaxed text-slate-500">
        Maly Roofing has been a trusted commercial and residential roofing
        contractor in the Greater Madison area for over three decades. We
        maintain, repair and replace roofs on warehouses, retail centers,
        office parks and industrial facilities, and we're known locally for
        our specialty work in green roof systems and rooftop paver
        installations.
      </p>
      <p class="text-lg leading-relaxed text-slate-500">
        We're a member of the National Roofing Contractors Association and
        Associated Builders and Contractors, and our crews are certified by
        the manufacturers whose materials we install — so every job is
        backed by both our experience and the people who make the products.
      </p>
    </div>

    <div class="mx-auto max-w-4xl mt-16">
      <h3 class="font-semibold text-xl text-gray-800 text-center">
        Certifications &amp; Memberships
      </h3>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6 mt-8">
        {
          credentials.map((c) => (
            <div class="flex items-center gap-3 bg-slate-50 rounded-lg p-4 border border-slate-100">
              <Icon class="w-5 h-5 text-brand-600 shrink-0" name={c.icon} />
              <span class="text-sm font-medium text-slate-700">{c.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</Layout>
