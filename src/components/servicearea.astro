---
import { Icon } from "astro-icon/components";

const cities = [
  "Columbus",
  "Dublin",
  "Westerville",
  "Grove City",
  "Reynoldsburg",
  "Hilliard",
  "Gahanna",
  "Delaware",
  "New Albany",
  "Pickerington",
];
---

<div id="service-area" class="mt-20 scroll-mt-24">
  <div
    class="grid lg:grid-cols-2 gap-10 items-center bg-slate-900 rounded-2xl px-8 py-12 md:px-16 md:py-16">
    <div class="flex justify-center order-last lg:order-first">
      <div class="relative w-56 h-56 shrink-0">
        <div
          class="absolute inset-0 rounded-full border-2 border-dashed border-brand-400/40">
        </div>
        <div class="absolute inset-6 rounded-full border-2 border-dashed border-brand-400/60">
        </div>
        <div class="absolute inset-12 rounded-full bg-brand-600/20"></div>
        <div
          class="absolute inset-0 flex items-center justify-center">
          <span
            class="flex items-center justify-center w-16 h-16 rounded-full bg-brand-600 shadow-lg">
            <Icon class="text-white w-8 h-8" name="bx:bxs-map" />
          </span>
        </div>
      </div>
    </div>
    <div>
      <h2 class="text-3xl lg:text-4xl font-bold tracking-tight text-white">
        Proudly Serving Central Ohio
      </h2>
      <p class="text-slate-300 mt-4 leading-relaxed">
        We dispatch crews within a 75-mile radius of Columbus for scheduled
        work, and prioritize emergency storm response anywhere in our service
        area. Not on the list? Give us a call — we take on regional projects
        too.
      </p>
      <ul class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-3">
        {
          cities.map((city) => (
            <li class="flex items-center gap-2 text-slate-200 text-sm">
              <Icon class="w-4 h-4 text-brand-400 shrink-0" name="bx:bxs-map-alt" />
              {city}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>
