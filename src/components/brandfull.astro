---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 300 195"
  class:list={[className]}
  role="img"
  aria-label="Maly Roofing">
  <g fill="#111111" transform="translate(0,0) scale(1,0.65)">
    <rect x="0" y="85" width="24" height="45"></rect>
    <rect x="26" y="98" width="16" height="32"></rect>
    <rect x="44" y="62" width="28" height="68"></rect>
    <rect x="74" y="88" width="18" height="42"></rect>
    <rect x="94" y="35" width="32" height="95"></rect>
    <rect x="128" y="75" width="20" height="55"></rect>
    <rect x="150" y="52" width="26" height="78"></rect>
    <rect x="154" y="44" width="6" height="8"></rect>
    <rect x="166" y="44" width="6" height="8"></rect>
    <rect x="178" y="92" width="16" height="38"></rect>
    <rect x="196" y="66" width="30" height="64"></rect>
    <rect x="228" y="82" width="18" height="48"></rect>
    <rect x="248" y="45" width="26" height="85"></rect>
    <rect x="276" y="76" width="22" height="54"></rect>
    <line
      x1="110"
      y1="35"
      x2="110"
      y2="18"
      stroke="#111111"
      stroke-width="3"
      stroke-linecap="round"></line>
  </g>
  <rect
    x="4"
    y="140"
    width="292"
    height="46"
    rx="10"
    fill="#4c8a96"
    stroke="#111111"
    stroke-width="5"></rect>
  <text
    x="150"
    y="172"
    text-anchor="middle"
    font-family="Arial, sans-serif"
    font-weight="800"
    font-size="30"
    letter-spacing="2"
    fill="#111111">MALY ROOFING</text>
</svg>
