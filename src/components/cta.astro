---
import Link from "./ui/link.astro";
import { Icon } from "astro-icon/components";
---

<div
  class="bg-slate-900 p-8 md:px-20 md:py-16 mt-20 mx-auto max-w-5xl rounded-lg flex flex-col items-center text-center">
  <Icon class="w-10 h-10 text-brand-400" name="bx:bxs-cloud-lightning" />
  <h2 class="text-white text-4xl md:text-5xl tracking-tight mt-4">
    Storm Damage? We Respond Fast.
  </h2>
  <p class="text-slate-400 mt-4 text-lg md:text-xl max-w-2xl">
    Wind, hail or fallen debris — our emergency crews can tarp and secure your
    roof fast, then help you navigate the insurance claim.
  </p>
  <div class="flex flex-col sm:flex-row gap-3 mt-6">
    <Link href="tel:+16082497663" style="primary" class="flex gap-2 items-center justify-center">
      <Icon class="w-4 h-4" name="bx:bxs-phone" />
      Call (608) 249-7663
    </Link>
    <Link href="/contact" style="inverted">Request Emergency Service</Link>
  </div>
</div>
