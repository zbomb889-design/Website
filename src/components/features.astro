---
import { Icon } from "astro-icon/components";

const services = [
  {
    title: "Roof Repair",
    description:
      "Fast, reliable fixes for leaks, punctures, flashing failures and ponding water before they turn into bigger problems.",
    icon: "bx:bxs-wrench",
  },
  {
    title: "Roof Replacement",
    description:
      "Full tear-off and re-roof projects using TPO, EPDM, metal and modified bitumen systems built for commercial loads.",
    icon: "bx:bxs-layer-plus",
  },
  {
    title: "Roof Inspections",
    description:
      "Detailed inspections with photo documentation and a clear report so you know exactly what your roof needs.",
    icon: "bx:bxs-search-alt-2",
  },
  {
    title: "Preventive Maintenance",
    description:
      "Scheduled maintenance programs that catch small issues early, extend roof life and protect your warranty.",
    icon: "bx:bxs-calendar-check",
  },
  {
    title: "Storm Damage Restoration",
    description:
      "Rapid tarping and emergency response after hail, wind and heavy rain, plus full insurance claim support.",
    icon: "bx:bxs-cloud-lightning",
  },
  {
    title: "New Construction & Coatings",
    description:
      "Roofing for new commercial builds and reflective coatings that extend the life of your existing roof system.",
    icon: "bx:bxs-buildings",
  },
];
---

<div id="services" class="mt-16 md:mt-0 scroll-mt-24">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight text-slate-900">
    Commercial Roofing Services
  </h2>
  <p class="text-lg mt-4 text-slate-600 max-w-2xl">
    From a single-line repair to a full re-roof, our certified crews handle
    every stage of your building's roof life cycle.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-x-10 gap-y-12">
  {
    services.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-slate-900 rounded-md p-2 w-10 h-10 shrink-0 flex items-center justify-center">
          <Icon class="text-brand-400 w-5 h-5" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg text-slate-900">{item.title}</h3>
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
