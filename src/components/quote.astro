---
import Contactform from "@/components/contactform.astro";
import { Icon } from "astro-icon/components";
---

<div id="quote" class="mt-20 mb-8 scroll-mt-24">
  <div class="grid lg:grid-cols-2 gap-12 items-start">
    <div>
      <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight text-slate-900">
        Request a Free Quote
      </h2>
      <p class="text-lg mt-4 text-slate-600 max-w-lg">
        Tell us about your property and we'll get back to you within one
        business day with next steps — usually sooner for storm damage.
      </p>
      <div class="mt-6 space-y-3">
        <div class="flex items-center gap-3 text-slate-700">
          <Icon class="w-5 h-5 text-brand-600 shrink-0" name="bx:bxs-phone" />
          <a href="tel:+16082497663" class="hover:text-slate-900"
            >(608) 249-7663</a
          >
        </div>
        <div class="flex items-center gap-3 text-slate-700">
          <Icon class="w-5 h-5 text-brand-600 shrink-0" name="uil:envelope" />
          <a
            href="mailto:info@malyroofing.com"
            class="hover:text-slate-900">info@malyroofing.com</a
          >
        </div>
        <div class="flex items-center gap-3 text-slate-700">
          <Icon class="w-5 h-5 text-brand-600 shrink-0" name="bx:bxs-map" />
          <span>4202 Robertson Rd, Madison, WI 53714</span>
        </div>
      </div>
    </div>
    <div class="bg-slate-50 border border-slate-100 rounded-xl p-6 md:p-8">
      <Contactform />
    </div>
  </div>
</div>
